<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.thiernoyunusdiallo.esp32-voice-mode</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/thiernodiallo/.bun/bin/bun</string>
    <string>run</string>
    <string>src/listener.ts</string>
    <string>--port</string>
    <string>8790</string>
  </array>
  <!-- Edit this and the bun path above to move this to another Mac. -->
  <key>WorkingDirectory</key>
  <string>/Users/thiernodiallo/Coding/Hardware/esp32-chatgpt-voice-mode</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/thiernodiallo</string>
    <key>PATH</key>
    <string>/Users/thiernodiallo/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <!-- Voice sessions sometimes come up with a healthy event channel and no
         audio on it. This asks the Codex app-server to say what its realtime
         module is doing, which is the only place that can tell "no audio was
         produced" apart from "audio was produced and never arrived". -->
    <key>RUST_LOG</key>
    <string>codex_core::realtime_conversation=trace,codex_realtime=trace</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/esp32-voice-mode.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/esp32-voice-mode.err.log</string>
</dict>
</plist>
